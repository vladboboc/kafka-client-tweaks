<?xml version="1.0" encoding="UTF-8"?>
<!-- Demos print their own tables to stdout. Kafka's INFO logging (full config dumps on every client
     creation, metadata updates, group coordinator chatter) would bury them, so it is kept at WARN.
     Turn it up when you want to see what the client is doing:  -Dkafka.log=INFO  -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.kafka" level="${kafka.log:-WARN}"/>
    <logger name="io.confluent" level="${kafka.log:-WARN}"/>
    <logger name="io.kafkatweaks" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
