<?xml version="1.0" encoding="UTF-8"?>
<!-- The demos log everything they report (tables, findings, warnings) through SLF4J, and Logback writes it to the
     console: the same pair a Spring Boot application uses by default, with the same pattern as the Spring module
     (logging.pattern.console in its application.yml). A table is logged as one multi-line message, so only its title
     line carries the time / level / logger prefix and the columns stay aligned.
     Kafka's INFO logging (full config dumps on every client creation, metadata updates, group coordinator chatter)
     would bury the tables, so it is kept at WARN. Turn it up when you want to see what the client is doing:  -Dkafka.log=INFO  -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.kafka" level="${kafka.log:-WARN}"/>
    <logger name="io.confluent" level="${kafka.log:-WARN}"/>
    <logger name="io.kafkatweaks" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
