<?xml version="1.0" encoding="UTF-8"?>
<!-- Logs go to stderr so the demos' tables (stdout) stay clean, the same convention as plain-clients.
     Levels live in application.yml (logging.level.*); Boot applies them on top of this file. -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
